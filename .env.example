# Copy to .env and fill in.

DATABASE_URL="file:./dev.db"

# ─── WIRED ───────────────────────────────────────────────────────────────────
# Sealed/used values AND set metadata (name, theme, pieces, MSRP, retirement).
# One call serves both, cached once per set per day — the quota is 100/day,
# resetting 00:00 UTC.
BRICKECONOMY_API_KEY=

# Set artwork, and name search on the Lookup page. Read-only /lego/ GETs, roughly one request
# per second — the adapter serialises every call, because Rebrickable bans IPs that burst.
# Free key from https://rebrickable.com/api/
REBRICKABLE_API_KEY=

# src/db/brickset/ — the candidate pool for the /retiring board (set numbers, names, themes,
# exit dates, MSRP, artwork). Free key from https://brickset.com/tools/webservices/v3
#
# A SEPARATE allowance from BrickEconomy's, and only getSets counts against it — which is why
# discovery goes through Brickset while per-set valuation stays on BrickEconomy. Spent only by
# the explicit "Sync retiring list" button: roughly 12 requests for a full pull, 5 for a refresh.
#
# Brickset publishes no limit through its API (getKeyUsageStats reports usage and nothing else),
# so the app shows a Brickset count with no denominator rather than inventing one.
BRICKSET_API_KEY=

# Retiring window for /retiring, in months. Default 6, override per view with ?months=12.
# Both are cache-side filters, so neither can cost a request.
# RETIRING_WINDOW_MONTHS=6

# The one estimation fallback: no-box value when BrickEconomy reports a used value but no
# used_low breakdown. Scaled from the OBSERVED with-box value, and printed as
# "estimated, not observed" by the CLI.
#
# There is deliberately no sealed-to-used factor. When a set has no used-market data at all
# (common while it is still in production), resell_used is reported unavailable rather than
# scored off an invented number.
# USED_NOBOX_FACTOR=0.80

# ─── NOT YET WIRED ───────────────────────────────────────────────────────────

# src/db/providers/partOutProvider.ts — part-out value
# BrickLink Price Guide. OAuth 1.0a: all four values are required together.
# Register at https://www.bricklink.com/v3/api/register_consumer.page
# BRICKLINK_CONSUMER_KEY=
# BRICKLINK_CONSUMER_SECRET=
# BRICKLINK_TOKEN_VALUE=
# BRICKLINK_TOKEN_SECRET=
