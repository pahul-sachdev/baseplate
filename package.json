{
  "name": "baseplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LEGO reselling valuation engine",
  "scripts": {
    "valuate": "node --env-file-if-exists=.env scripts/valuate.ts",
    "test": "node --env-file-if-exists=.env --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "db:push": "prisma db push",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.23",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
